datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  password           String?
  name               String?
  googleId           String?
  googleAccessToken  String?
  googleRefreshToken String?
  aiSpendUsd         Float          @default(0.0)
  spendLimitUsd      Float          @default(20.0)
  adminNotified      Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  cookbooks          Cookbook[]
  pantryItems        PantryItem[]
  scanSessions       ScanSession[]
  aiLogs             AiUsageLog[]
  customRecipes      CustomRecipe[]
  mealPlaylists      MealPlaylist[]
  mealHistory        MealHistory[]
  restaurantMenus    RestaurantMenu[]
  favorites          Favorite[]
}

model AiUsageLog {
  id          String   @id @default(cuid())
  actionType  String   // bookshelf_scan, recipe_index, index_ocr, fridge_scan, cover_gen, url_parse, notes_parse
  costUsd     Float    @default(0.0)
  promptChars Int      @default(0)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Cookbook {
  id             String    @id @default(cuid())
  title          String
  author         String?
  edition        String?
  coverColor     String?   @default("#dda031")
  coverImageUrl  String?
  spineSnippet   String?
  verified       Boolean   @default(true)
  totalRecipes   Int       @default(0)
  bookType       String    @default("cooking") // "cooking", "cocktail", "both"
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes        Recipe[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

model Recipe {
  id             String        @id @default(cuid())
  title          String
  pageNumber     Int?
  isFact         Boolean       @default(true) // true if confirmed from verified index, false if inferred
  servings       String?
  prepTime       String?
  cookTime       String?
  category       String?       @default("Main") // Main, Dessert, Cocktail, Aperitif, etc.
  glassware      String?       // Coupe, Rocks, Highball, Nick & Nora, Collins, Martini, Tiki Mug
  ice            String?       // Large Cube, Crushed, Neat, Up, Cubed
  technique      String?       // Shaken, Stirred, Built, Blended, Muddled
  sourceUrl      String?
  cookbookId     String
  cookbook       Cookbook      @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  ingredients    Ingredient[]
  favorites      Favorite[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([cookbookId])
}

model Ingredient {
  id             String    @id @default(cuid())
  name           String
  normalizedName String
  amount         String?
  unit           String?
  optional       Boolean   @default(false)
  recipeId       String
  recipe         Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([normalizedName])
}

model PantryItem {
  id                String    @id @default(cuid())
  name              String
  normalizedName    String
  category          String    @default("fridge") // fridge, freezer, pantry, spices
  quantity          String?
  unit              String?
  isAlwaysAvailable Boolean   @default(false) // always-stocked staples (salt, pepper, olive oil, etc.)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([normalizedName])
}

model ScanSession {
  id             String    @id @default(cuid())
  scanType       String    // bookshelf, fridge, pantry
  imageUrl       String?
  detectedCount  Int       @default(0)
  rawOutput      String?
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model CustomRecipe {
  id                String                   @id @default(cuid())
  title             String
  sourceType        String                   @default("manual") // "manual", "url", "cookbook", "photo_ocr", "ai"
  sourceUrl         String?
  cookbookTitle     String?
  pageNumber        Int?
  frequency         String                   @default("1_week") // "1_week", "2_month", "1_month", "occasional", "paused"
  servings          String?                  @default("2-4")
  servingsNum       Float?                   @default(4.0)
  prepTime          String?
  cookTime          String?
  tags              String?                  // comma-separated tags e.g. "Weeknight, Quick, High-Protein"
  cuisine           String?                  // "Italian", "Mexican", "Asian", "American", etc.
  mealCategory      String?                  @default("dinner") // "dinner", "lunch", "breakfast", "dessert", "side", "snack"
  rating            Float?                   @default(5.0)
  imageUrl          String?
  instructions      String?                  // JSON string array or markdown text
  notes             String?
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients       CustomRecipeIngredient[]
  favorites         Favorite[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([userId])
}

model CustomRecipeIngredient {
  id             String       @id @default(cuid())
  name           String
  normalizedName String
  amount         String?
  unit           String?
  aisleCategory  String       @default("pantry") // produce, meat, dairy, pantry, spices, other
  optional       Boolean      @default(false)
  recipeId       String
  recipe         CustomRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([normalizedName])
}

model MealPlaylist {
  id           String    @id @default(cuid())
  name         String    @default("Dinner Rotation")
  daysCount    Int       @default(3) // 3 or 4
  scheduleJson String    // JSON string of array: [{ day: 1, recipeId: "...", locked: boolean }]
  active       Boolean   @default(true)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model MealHistory {
  id          String   @id @default(cuid())
  recipeTitle String
  recipeId    String?
  cookedAt    DateTime @default(now())
  sourceType  String?  @default("custom") // "custom", "cookbook", "manual"
  notes       String?
  rating      Int?     @default(5)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([cookedAt])
}

model RestaurantMenu {
  id             String               @id @default(cuid())
  restaurantName String
  city           String?
  notes          String?
  imageUrl       String?
  menuType       String               @default("food") // "food", "cocktail", "both"
  userId         String?              // Contributed by user
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  cocktails      RestaurantCocktail[]
  dishes         RestaurantDish[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([restaurantName])
  @@index([userId])
}

model RestaurantCocktail {
  id              String                         @id @default(cuid())
  name            String
  menuDescription String?                        // Raw menu ingredients/description
  spiritBase      String?                        // "Bourbon / Rye", "Gin", "Tequila / Mezcal", "Rum", "Vodka", "Other"
  flavorProfile   String?                        // "sour", "bitter", "boozy", "tiki", "herbal", "highball", "dessert"
  glassware       String?                        // "Coupe", "Rocks", "Highball", "Nick & Nora", "Martini", etc.
  ice             String?                        // "Large Cube", "Crushed", "Neat", "Up", "Cubed"
  technique       String?                        // "Shaken", "Stirred", "Built"
  garnish         String?
  instructions    String?                        // JSON array string of steps
  menuId          String
  menu            RestaurantMenu                 @relation(fields: [menuId], references: [id], onDelete: Cascade)
  ingredients     RestaurantCocktailIngredient[]
  favorites       Favorite[]
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([menuId])
  @@index([name])
}

model RestaurantCocktailIngredient {
  id             String             @id @default(cuid())
  name           String
  normalizedName String
  amount         String?            // "2", "0.75", "2 dashes"
  unit           String?            // "oz", "dashes", "tsp", "ml", "splash"
  optional       Boolean            @default(false)
  cocktailId     String
  cocktail       RestaurantCocktail @relation(fields: [cocktailId], references: [id], onDelete: Cascade)

  @@index([cocktailId])
  @@index([normalizedName])
}

model RestaurantDish {
  id              String                     @id @default(cuid())
  name            String
  category        String?                    // "Appetizer", "Pasta", "Entree", "Pizza", "Salad", "Soup", "Side", "Dessert", "Brunch", "Main"
  menuDescription String?                    // Original menu text / notes
  prepTime        String?                    // "15 mins"
  cookTime        String?                    // "25 mins"
  servings        String?                    // "2-4 servings"
  difficulty      String?                    // "Easy", "Medium", "Chef-level"
  dietaryTags     String?                    // "Vegetarian, Gluten-Free"
  chefTips        String?                    // Culinary secret / tip
  instructions    String?                    // JSON array string of cooking steps
  menuId          String
  menu            RestaurantMenu             @relation(fields: [menuId], references: [id], onDelete: Cascade)
  ingredients     RestaurantDishIngredient[]
  favorites       Favorite[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([menuId])
  @@index([name])
  @@index([category])
}

model RestaurantDishIngredient {
  id             String         @id @default(cuid())
  name           String
  normalizedName String
  amount         String?        // "2", "1/2", "1"
  unit           String?        // "tbsp", "cup", "oz", "cloves", "lb", "pinch"
  aisleCategory  String         @default("pantry") // produce, meat, seafood, dairy, pantry, spices, bakery
  optional       Boolean        @default(false)
  dishId         String
  dish           RestaurantDish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId])
  @@index([normalizedName])
}

model Favorite {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 String              // "recipe" (food) or "cocktail"
  title                String
  sourceType           String?             // "cookbook", "restaurant", "custom", "web"
  cookbookTitle        String?
  pageNumber           Int?
  recipeId             String?
  recipe               Recipe?             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  restaurantDishId     String?
  restaurantDish       RestaurantDish?     @relation(fields: [restaurantDishId], references: [id], onDelete: Cascade)
  restaurantCocktailId String?
  restaurantCocktail   RestaurantCocktail? @relation(fields: [restaurantCocktailId], references: [id], onDelete: Cascade)
  customRecipeId       String?
  customRecipe         CustomRecipe?       @relation(fields: [customRecipeId], references: [id], onDelete: Cascade)
  metadataJson         String?             // JSON string for web cocktail specs, ingredients, instructions, etc.
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([userId, type, title])
  @@index([userId, type])
  @@index([recipeId])
  @@index([restaurantDishId])
  @@index([restaurantCocktailId])
  @@index([customRecipeId])
}
